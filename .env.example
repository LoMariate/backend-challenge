# Copie para .env no desenvolvimento LOCAL. Nao use estas credenciais em producao.
# Ajuste as credenciais/portas se o seu compose base utilizar outros valores.
DATABASE_URL=postgresql://backend:backend@127.0.0.1:5432/backend_challenge
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_EVENTS_QUEUE_URL=http://127.0.0.1:4566/queue/us-east-1/000000000000/wager-events.fifo
SQS_WAGER_QUEUE_URL=http://127.0.0.1:4566/queue/us-east-1/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://127.0.0.1:4566/queue/us-east-1/000000000000/wager-transactions-dlq.fifo
SQS_WAGER_VISIBILITY_SECONDS=120
SQS_WAGER_WAIT_SECONDS=10
PORT=3000
HOST=127.0.0.1
